{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dukeskyloafer-com",
  "compatibility_date": "2025-04-04",
  "main": "./workers/app.ts",
  "vars": {
    "YOUTUBE_CHANNEL_ID": "UCv1a_xOMw3V9fsXoro3Is5Q",
    "GITHUB_USERNAME": "briansokol"
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "<will-be-filled-after-creation>"
    }
  ]
  // Secrets (set via `npx wrangler secret put`):
  // - YOUTUBE_API_KEY
  // - GITHUB_TOKEN
}
